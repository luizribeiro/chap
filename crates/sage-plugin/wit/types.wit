package sage:agent@0.2.0;

interface types {
  record tool-definition {
    name: string,
    description: string,
    parameters: string,
  }

  record tool-call {
    id: string,
    name: string,
    arguments: string,
  }

  record tool-result {
    call-id: string,
    name: string,
    output: string,
    is-error: bool,
  }

  variant assistant-content {
    text(string),
    tool-call(tool-call),
  }

  variant message {
    system(string),
    user(string),
    assistant(list<assistant-content>),
    tool-result(tool-result),
  }

  record completion-request {
    messages: list<message>,
    tools: list<tool-definition>,
  }

  variant finish-reason {
    stop,
    tool-calls,
    length,
    other(string),
  }

  record completion {
    content: list<assistant-content>,
    finish-reason: finish-reason,
  }
}
