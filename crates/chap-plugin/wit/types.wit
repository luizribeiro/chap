package chap:agent@0.2.0;

interface types {
  record tool-definition {
    name: string,
    description: string,
    parameters: string,
  }

  enum execution-mode {
    parallel,
    sequential,
  }

  record tool-registration {
    definition: tool-definition,
    execution-mode: execution-mode,
  }

  record tool-call {
    id: string,
    name: string,
    arguments: string,
  }

  record tool-result {
    call-id: string,
    name: string,
    output: string,
    is-error: bool,
  }

  variant assistant-content {
    text(string),
    tool-call(tool-call),
  }

  variant message {
    system(string),
    user(string),
    assistant(list<assistant-content>),
    tool-result(tool-result),
  }

  record completion-request {
    messages: list<message>,
    tools: list<tool-definition>,
  }

  variant finish-reason {
    stop,
    tool-calls,
    length,
    other(string),
  }

  record rate-limit {
    /// Seconds the provider asked the caller to wait, when it said so.
    retry-after: option<u64>,
    message: string,
  }

  variant provider-error {
    rate-limited(rate-limit),
    /// The request exceeded the model's context window.
    context-too-long(string),
    /// Credentials are missing, invalid, or lack access to the model.
    unauthorized(string),
    /// The upstream service was unreachable or failed internally.
    unavailable(string),
    /// The model declined to answer.
    refused(string),
    /// Anything else, including transport and decoding failures.
    other(string),
  }

  record usage {
    /// The whole prompt, including cached input tokens.
    input-tokens: u64,
    /// The portion of input-tokens served from cache. Absent when the provider
    /// did not report this counter, which is distinct from a reported zero.
    cached-input-tokens: option<u64>,
    /// Tokens written into the provider's prompt cache by this step, billed at a
    /// write premium rather than included in input-tokens. Absent when the
    /// provider did not report this counter.
    cache-write-tokens: option<u64>,
    /// The whole completion, including reasoning tokens.
    output-tokens: u64,
    /// The portion of output-tokens spent on reasoning. Absent when the provider
    /// did not report this counter, which is distinct from a reported zero.
    reasoning-tokens: option<u64>,
  }

  record completion {
    content: list<assistant-content>,
    finish-reason: finish-reason,
    usage: option<usage>,
  }
}
